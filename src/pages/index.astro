---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AliceBaw - Home">
  <div class="hero">
    <h1>Welcome to AliceBaw</h1>
    <p class="subtitle">A modern blog powered by Astro and Markdown</p>
    <div class="cta-buttons">
      <a href="/blog" class="btn btn-primary">Read the Blog</a>
      <a href="#about" class="btn btn-secondary">Learn More</a>
    </div>
  </div>

  <section id="about" class="section">
    <h2>About This Site</h2>
    <p>
      This is a modern, fast, and SEO-friendly website built with Astro.
      It features a static site generation (SSG) approach, making it perfect
      for deployment to GitHub Pages.
    </p>
    <p>
      All blog posts are written in Markdown, making it easy to create and
      manage content without touching any code.
    </p>
  </section>

  <section class="section">
    <h2>Features</h2>
    <div class="features-grid">
      <div class="feature">
        <h3>⚡ Lightning Fast</h3>
        <p>Built with Astro for optimal performance and zero JavaScript by default.</p>
      </div>
      <div class="feature">
        <h3>📝 Markdown Powered</h3>
        <p>Write your blog posts in Markdown with full MDX support.</p>
      </div>
      <div class="feature">
        <h3>🎨 Modern Design</h3>
        <p>Clean and responsive design that works on all devices.</p>
      </div>
      <div class="feature">
        <h3>🚀 Easy Deploy</h3>
        <p>Deploy to GitHub Pages with a simple GitHub Actions workflow.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 2rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-block;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
  }

  .btn-secondary:hover {
    background: var(--primary);
    color: white;
    transform: translateY(-2px);
  }

  .section {
    padding: 3rem 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .feature {
    padding: 1.5rem;
    background: var(--bg-secondary);
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .feature h3 {
    margin-bottom: 0.5rem;
  }

  .feature p {
    color: var(--text-light);
    margin-bottom: 0;
  }
</style>
